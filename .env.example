# Copia este archivo como .env.local y completa los valores.
# Ojo: todas las variables EXPO_PUBLIC_ quedan incrustadas en el bundle de la app.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# https://carvector.io (especificaciones, imágenes, recalls)
EXPO_PUBLIC_CARVECTOR_API_KEY=

# https://www.marketcheck.com (precios de mercado)
EXPO_PUBLIC_MARKETCHECK_API_KEY=
